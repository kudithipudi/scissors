# App
APP_NAME=Rock Paper Scissors
# Only set this if the app is reverse-proxied under a URL prefix, e.g.
# ROOT_PATH=/scissors for https://your-domain.com/scissors/. Leave blank
# if it's served from the domain root.
ROOT_PATH=
DEBUG=false

# Security
SECRET_KEY=your_secret_key_change_this_in_production
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_MAX_AGE=86400

# Database
DB_PATH=data/scissors.db

# Admin
ADMIN_PASSWORD=your_admin_password

# Optional "powered by" link shown in the header/footer. Leave both blank
# to omit it entirely.
SITE_LINK_URL=
SITE_LINK_LABEL=

# Application Configuration
GAME_TIMEOUT_MINUTES=2
MAX_GAMES_PER_IP_PER_HOUR=10
RATE_LIMIT_WINDOW_SECONDS=3600
SHAKE_THRESHOLD=15
REQUIRED_SHAKES=3
SHAKE_TIMEOUT_MS=1000

# QR code configuration
QR_BOX_SIZE=10
QR_BORDER=4

# Logging
LOG_LEVEL=info
